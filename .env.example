# Configure these in your process environment; Spring Boot does not automatically load this file.
REPAIR_DB_URL=jdbc:mysql://localhost:3306/repair_system?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
REPAIR_DB_USERNAME=repair
REPAIR_DB_PASSWORD=
REPAIR_REDIS_HOST=localhost
REPAIR_REDIS_PORT=6379
REPAIR_REDIS_DATABASE=8
REPAIR_REDIS_PASSWORD=
REPAIR_BOOTSTRAP_ENABLED=false
REPAIR_OCR_ENABLED=false

# Tencent Cloud GeneralAccurateOCR; enable after providing service credentials.
REPAIR_OCR_SECRET_ID=
REPAIR_OCR_SECRET_KEY=
REPAIR_OCR_REGION=ap-guangzhou

# SMTP example: QQ mailbox, implicit TLS on port 465; use the mailbox authorization code.
REPAIR_MAIL_HOST=smtp.qq.com
REPAIR_MAIL_PORT=465
REPAIR_MAIL_USERNAME=
REPAIR_MAIL_PASSWORD=
REPAIR_MAIL_AUTH=true
REPAIR_MAIL_SSL=true
REPAIR_MAIL_STARTTLS=false
REPAIR_MAIL_STARTTLS_REQUIRED=false

# Local OCR is the default provider and needs no cloud credential.
REPAIR_OCR_PROVIDER=LOCAL
REPAIR_OCR_LOCAL_URL=http://127.0.0.1:8601/v1/recognize

# Optional engineer read model. Enable together after Canal/ROW/FULL binlog is ready.
REPAIR_READ_CACHE_ENABLED=false
REPAIR_CANAL_ENABLED=false
REPAIR_CANAL_HOST=127.0.0.1
REPAIR_CANAL_PORT=11112
REPAIR_CANAL_DESTINATION=repair
REPAIR_CANAL_USERNAME=
REPAIR_CANAL_PASSWORD=

# Comma-separated frontend origins for separate-domain deployment.
REPAIR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Production: HTTPS Secure host-only cookies. Only local HTTP development sets false.
REPAIR_AUTH_COOKIE_SECURE=true
REPAIR_AUTH_COOKIE_SAME_SITE=Lax
